// Axis compiler primitives registry.
//
// Identities: §5b bootstrap rule — SHA-256 of the UTF-8 function name bytes.
// This is the scope-limited exception for stable-named compiler primitives;
// new user-defined functions MUST use entropy-minted identities instead.
//
// Two projections of this file that differ only in comments, whitespace, or
// field ordering MUST lower to identical canonical bytes (Format §8).

registry axis 0.5

// ─────────── types ───────────
type Unit  = prim unit
type Bool  = prim bool
type Int   = prim int
type Text  = prim text

// ─────────── unit operations ───────────
// unit_id: identity function on unit — §5b identity = SHA-256("unit_id")
fn unit_id
  identity 0x59e4aa5d01ba2b0703da58b5c1ae1b36717cbdb80a357687abe1665f759cf4cf
  kind leaf
  in (Unit)
  out Unit
  effect pure
  deterministic true
  idempotent true
end

// seq_unit: sequence two unit values — §5b identity = SHA-256("seq_unit")
fn seq_unit
  identity 0x99920a1c7a9ff7704d937b8833615de207765eb642792f0f0788cb31434e3bc6
  kind leaf
  in (Unit, Unit)
  out Unit
  effect pure
  deterministic true
  idempotent true
end

