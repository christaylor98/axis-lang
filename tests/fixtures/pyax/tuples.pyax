# expect-exit: 0
# tuples: literals, return a, b, unpacking, swap, indexing, lists of tuples
def min_max(xs: list[int]) -> tuple[int, int]:
    lo = xs[0]
    hi = xs[0]
    for x in xs:
        if x < lo:
            lo = x
        if x > hi:
            hi = x
    return lo, hi


def main(args: list[str]) -> int:
    lo, hi = min_max([4, 9, 1, 7])
    print(lo, hi)
    a = 1
    b = 2
    a, b = b, a
    print(a, b)
    pair = (3, "three")
    print(pair[0], pair[1], pair[-1])
    pairs = [("x", 1), ("y", 2), ("z", 3)]
    out = 0
    for name, v in pairs:
        if name != "y":
            out += v
    print(out)
    print(pair == (3, "three"), pair == (4, "four"))
    return hi - lo
