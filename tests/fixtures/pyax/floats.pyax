# expect-exit: 0
# floats and Decimals: literals, int promotion, true division, floor/mod,
# round (half to even), str() formatting, math, float(), loops over floats
import math
from decimal import Decimal


def mean(xs: list[float]) -> float:
    return sum(xs) / len(xs)


def main(args: list[str]) -> int:
    print(1.0, 0.1 + 0.2, 1e20, 0.00001, 2.5e-7, -0.0, 3.14159)
    print(7 / 2, 1 / 3, -7.5 // 2, -7.5 % 2, 7.5 % -2)
    print(round(2.5), round(3.5), round(-2.5), round(2.675, 2))
    print(int(3.99), int(-3.99), float(7), float(" 2.5 "))
    print(math.sqrt(16), math.floor(-2.5), math.ceil(2.1), math.pi)
    best = float("inf")
    for x in [3.5, -1.25, 9.0]:
        if x < best:
            best = x
    print(best, mean([1.0, 2.0, 4.0]), max(1.5, 2.0), abs(-2.5))
    print(2 ** 0.5, 2.0 ** 3, 10 * 0.1 == 1.0)
    d = Decimal("1.10") + Decimal("2.205")
    print(d, Decimal("1.5") * 2, Decimal("0.1") + Decimal("0.2") == Decimal("0.3"))
    print(d > 3, str(Decimal("19.99")), round(Decimal("2.675"), 2))
    return 0
